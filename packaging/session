#!/bin/sh
# [INPUT]: 依赖 labwc 会话、输入法、授权代理和桌面监督器。
# [OUTPUT]: 固定内屏布局，启动会话服务，退出时清理本会话创建的子进程。
# [POS]: labwc 的会话入口；崩溃预算由 Python 监督器维护。
# [PROTOCOL]: Update this header on change, then check AGENTS.md
set -eu
children=""
shell_pid=""
cleanup() {
    if [ -n "$shell_pid" ]; then
        kill "$shell_pid" 2>/dev/null || true
        wait "$shell_pid" 2>/dev/null || true
    fi
    for child in $children; do
        kill "$child" 2>/dev/null || true
    done
    python3 -m udeck.session_config restore || true
}
trap cleanup EXIT
trap 'exit 0' HUP INT TERM
dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP QT_IM_MODULE GDK_IM_MODULE XMODIFIERS || true
if wlr-randr | grep -q '^DSI-1 '; then
    # labwc 只在坐标改变时将自动位置转换为固定位置。
    wlr-randr --output DSI-1 --mode 720x1280 --transform 270 --scale 1 --pos 1,0 || true
    wlr-randr --output DSI-1 --pos 0,0 || true
fi
if ! pgrep -u "$(id -u)" -x fcitx5 >/dev/null; then
    fcitx5 &
    children="$children $!"
fi
if ! pgrep -u "$(id -u)" -x lxpolkit >/dev/null; then
    lxpolkit &
    children="$children $!"
fi
swayidle -w timeout 600 "wlopm --off '*'" resume "wlopm --on '*'" &
children="$children $!"
status=0
python3 -m udeck.session_supervisor &
shell_pid=$!
wait "$shell_pid" || status=$?
shell_pid=""
exit "$status"
