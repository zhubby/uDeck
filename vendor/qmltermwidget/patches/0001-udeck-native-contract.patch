+void TerminalDisplay::pasteText(QString text)
+{
+    if (!_screenWindow || text.isEmpty()) return;
+    text.replace(QStringLiteral("\r\n"), QStringLiteral("\n"));
+    text.replace(QLatin1Char('\n'), QLatin1Char('\r'));
+    bracketText(text);
+    QKeyEvent event(QEvent::KeyPress, 0, Qt::NoModifier, text);
+    emit keyPressedSignal(&event, true);
+    _screenWindow->clearSelection();
+    scrollToEnd();
+}
+
+void TerminalDisplay::beginHistory()
+{
+    if (!_screenWindow) return;
+    _screenWindow->setTrackOutput(false);
+    _historyAnchored = false;
+    _historyActive = true;
+    _historyCursor = QPoint(0, _screenWindow->currentLine() +
+                           _screenWindow->cursorPosition().y());
+    updateHistorySelection();
+}
+
+void TerminalDisplay::moveHistory(int columns, int lines)
+{
+    if (!_screenWindow) return;
+    // Preserve content position when a bounded history has evicted old lines.
+    _historyCursor.setY(qBound(0, _historyCursor.y() + lines,
+                              _screenWindow->lineCount() - 1));
+    _historyCursor.setX(qBound(0, _historyCursor.x() + columns,
+                              _screenWindow->columnCount() - 1));
+    const int row = _historyCursor.y();
+    const int top = _screenWindow->currentLine();
+    if (row < top) _screenWindow->scrollTo(row);
+    else if (row >= top + _screenWindow->windowLines())
+        _screenWindow->scrollTo(row - _screenWindow->windowLines() + 1);
+    Character *image = _screenWindow->getImage();
+    const int offset = (row - _screenWindow->currentLine()) * _screenWindow->columnCount();
+    // Wide-character continuation cells are never selection endpoints.
+    if (_historyCursor.x() > 0 && image[offset + _historyCursor.x()].character == 0)
+        _historyCursor.rx() += columns > 0 && _historyCursor.x() + 1 < _screenWindow->columnCount() ? 1 : -1;
+    updateHistorySelection();
+}
+
+void TerminalDisplay::updateHistorySelection()
+{
+    if (!_screenWindow) return;
+    Screen *screen = _screenWindow->screen();
+    const int row = qBound(0, _historyCursor.y(), _screenWindow->lineCount() - 1);
+    const int col = qBound(0, _historyCursor.x(), _screenWindow->columnCount() - 1);
+    if (!_historyAnchored) screen->setSelectionStart(col, row, false);
+    screen->setSelectionEnd(col, row);
+    // Rebuild the selection attributes through the native viewport.
+    _screenWindow->refreshSelection();
+    updateImage();
+}
+
+void TerminalDisplay::anchorHistory()
+{
+    _historyAnchored = true;
+}
+
+QString TerminalDisplay::selectedHistoryText() const
+{
+    return _screenWindow ? _screenWindow->selectedText(true) : QString();
+}
+
+void TerminalDisplay::leaveHistory()
+{
+    if (!_screenWindow) return;
+    _historyAnchored = false;
+    _historyActive = false;
+    _screenWindow->clearSelection();
+    _screenWindow->setTrackOutput(true);
+    scrollToEnd();
+    updateImage();
+}
+
+bool TerminalDisplay::searchText(const QString &text, bool forwards)
+{
+    if (!_screenWindow || text.isEmpty()) return false;
+    const int width = _screenWindow->columnCount();
+    QVector<Character> cells(width);
+    QString logical;
+    QList<QPoint> positions;
+    QList<QPair<QPoint, QPoint>> matches;
+    const auto properties = _screenWindow->screen()->getLineProperties(0, _screenWindow->lineCount() - 1);
+    for (int row = 0; row < _screenWindow->lineCount(); ++row) {
+        _screenWindow->screen()->getImage(cells.data(), width, row, row);
+        for (int col = 0; col < width; ++col) {
+            const Character &cell = cells[col];
+            if (cell.character == 0) continue;
+            QString value;
+            if (cell.rendition & RE_EXTENDED_CHAR) {
+                ushort length = 0;
+                const uint *chars = ExtendedCharTable::instance.lookupExtendedChar(cell.character, length);
+                value = QString::fromUcs4(chars, length);
+            } else {
+                const char32_t code = cell.character;
+                value = QString::fromUcs4(&code, 1);
+            }
+            logical += value;
+            for (int unit = 0; unit < value.size(); ++unit) positions.append(QPoint(col, row));
+        }
+        if (row < properties.size() && (properties[row] & LINE_WRAPPED)) continue;
+        int at = -1;
+        while ((at = logical.indexOf(text, at + 1, Qt::CaseSensitive)) >= 0)
+            matches.append(qMakePair(positions[at], positions[at + text.size() - 1]));
+        logical.clear();
+        positions.clear();
+    }
+    if (matches.isEmpty()) return false;
+    auto chosen = forwards ? matches.first() : matches.last();
+    const int cursor = _historyCursor.y() * width + _historyCursor.x();
+    if (forwards) {
+        for (const auto &match : matches) {
+            if (match.first.y() * width + match.first.x() > cursor) { chosen = match; break; }
+        }
+    } else {
+        for (auto it = matches.crbegin(); it != matches.crend(); ++it) {
+            if (it->first.y() * width + it->first.x() < cursor) { chosen = *it; break; }
+        }
+    }
+    _historyCursor = chosen.first;
+    _historyAnchored = true;
+    _historyActive = true;
+    _screenWindow->setTrackOutput(false);
+    _screenWindow->scrollTo(chosen.first.y());
+    _screenWindow->screen()->setSelectionStart(chosen.first.x(), chosen.first.y(), false);
+    _screenWindow->screen()->setSelectionEnd(chosen.second.x(), chosen.second.y());
+    _screenWindow->refreshSelection();
+    updateImage();
+    return true;
+}
