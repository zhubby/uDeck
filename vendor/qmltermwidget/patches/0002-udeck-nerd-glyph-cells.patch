+static int characterWidth(const QFontMetrics& metrics, quint32 codepoint)
+{
+    const char32_t character = static_cast<char32_t>(codepoint);
+    return metrics.horizontalAdvance(QString::fromUcs4(&character, 1));
+}
+
+static bool isPrivateUse(quint32 codepoint)
+{
+    return QChar::category(static_cast<char32_t>(codepoint)) == QChar::Other_PrivateUse;
+}
