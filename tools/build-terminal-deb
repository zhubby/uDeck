#!/usr/bin/env python3
"""Compatibility entrypoint for the unified Debian release builder."""

import argparse
import subprocess
import sys
from pathlib import Path

root = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--plugin", type=Path, help="Validate a legacy plugin before rebuilding from matching source")
parser.add_argument("--output", type=Path, default=root / "dist/release")
options = parser.parse_args()
if options.plugin is not None:
    for name, source in (("udeck", "terminal.colorscheme"), ("udeck-dark", "terminal-dark.colorscheme")):
        palette = options.plugin / "color-schemes" / (name + ".colorscheme")
        if not palette.is_file() or palette.read_bytes() != (root / "packaging" / source).read_bytes():
            raise SystemExit(f"Rebuild the native plugin: missing or stale {name} color scheme.")
subprocess.run([sys.executable, str(root / "tools/build-release"), "--output", str(options.output)], check=True)
