#!/bin/sh
set -eu
umask 022
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if ! command -v dpkg-deb >/dev/null; then
    printf '%s\n' 'Build this package on Debian/arm64 with dpkg-deb installed.' >&2
    exit 1
fi
version=$(PYTHONPATH="$root/src" python3 -c 'import udeck; print(udeck.__version__)')
architecture=$(dpkg --print-architecture)
output=${1:-"$root/dist"}
mkdir -p "$output"
output=$(CDPATH= cd -- "$output" && pwd)
staging=$(mktemp -d)
chmod 755 "$staging"
trap 'rm -rf "$staging"' EXIT HUP INT TERM
mkdir -p "$staging/DEBIAN" "$staging/usr/bin" "$staging/usr/lib/python3/dist-packages" "$staging/usr/libexec/udeck" "$staging/usr/share/udeck" "$staging/usr/share/wayland-sessions" "$staging/usr/share/applications" "$staging/usr/share/icons/hicolor/scalable/apps" "$staging/usr/share/xdg-desktop-portal"
cp -R "$root/src/udeck" "$staging/usr/lib/python3/dist-packages/"
rm -rf "$staging/usr/lib/python3/dist-packages/udeck/terminal"
rm -rf "$staging/usr/lib/python3/dist-packages/udeck/apps"
find "$staging/usr/lib/python3/dist-packages" -type d -name __pycache__ -prune -exec rm -rf '{}' ';'
cp "$root/packaging/bin/udeck" "$root/packaging/bin/udeckctl" "$root/packaging/bin/udeck-session" "$staging/usr/bin/"
cp "$root/packaging/session" "$staging/usr/libexec/udeck/session"
chmod 755 "$staging/usr/bin/udeck" "$staging/usr/bin/udeckctl" "$staging/usr/bin/udeck-session" "$staging/usr/libexec/udeck/session"
cp -R "$root/packaging/labwc" "$staging/usr/share/udeck/"
cp "$root/packaging/udeck.desktop" "$staging/usr/share/wayland-sessions/udeck.desktop"
cp "$root/packaging/io.github.zhubby.uDeck.desktop" "$staging/usr/share/applications/"
cp "$root/packaging/udeck.svg" "$staging/usr/share/icons/hicolor/scalable/apps/io.github.zhubby.uDeck.svg"
cp "$root/packaging/udeck-portals.conf" "$staging/usr/share/xdg-desktop-portal/"
find "$staging" -type f -name '._*' -delete
cat > "$staging/DEBIAN/control" <<EOF
Package: udeck
Version: $version
Architecture: $architecture
Maintainer: uDeck Project
Section: x11
Priority: optional
Depends: python3 (>= 3.11), python3-pyside6.qtquick (>= 6.8), python3-pyside6.qtqml, python3-pyside6.qtdbus, python3-pyside6.qtmultimedia (>= 6.8), python3-pyside6.qtquickcontrols2, python3-dbus-next, python3-evdev, python3-gi, qml6-module-qtquick, qml6-module-qtquick-controls, qml6-module-qtquick-layouts, qml6-module-qtquick-window, qml6-module-qtqml-workerscript, qml6-module-qtquick-templates, qt6-wayland, labwc (>= 0.9), wlr-randr, libwayland-client0, libxkbcommon0, network-manager, bluez, systemd, tzdata, wireplumber, pipewire-pulse, pulseaudio-utils, libglib2.0-bin, swayidle, swaylock, wlopm, fcitx5, fcitx5-frontend-qt6, lxpolkit, dbus-user-session, xdg-desktop-portal-wlr, xdg-desktop-portal-gtk, fonts-noto-cjk, xdg-terminal-exec
Description: Button-first desktop shell for ClockworkPi uConsole
 Native Qt Quick shell with application and window management, files,
 Wi-Fi, Bluetooth, audio and power controls. Adds an optional labwc
 session without changing the existing desktop or login defaults.
EOF
dpkg-deb --root-owner-group --build "$staging" "$output/udeck_${version}_${architecture}.deb"
